---
// Jeu d'icônes maison, en trait, sans dépendance ni police externe.
// Même épaisseur, même grille 24, couleur héritée du parent : elles se
// fondent dans la typographie au lieu de faire tache.
const { name, size = 20 } = Astro.props;

const paths = {
  wind: ["M3 8h9.5a2.75 2.75 0 1 0-2.75-2.75", "M3 12h13a3 3 0 1 1-3 3", "M3 16h7.5a2.25 2.25 0 1 1-2.25 2.25"],
  wave: ["M2 9c2.4 0 2.4 2 4.8 2s2.4-2 4.8-2 2.4 2 4.8 2 2.4-2 4.8-2", "M2 14c2.4 0 2.4 2 4.8 2s2.4-2 4.8-2 2.4 2 4.8 2 2.4-2 4.8-2"],
  shield: ["M12 3l7 2.8v5.4c0 4.2-2.9 7.6-7 8.8-4.1-1.2-7-4.6-7-8.8V5.8z", "M9 12l2.2 2.2L15.5 10"],
  mail: ["M3.5 6h17v12h-17z", "M3.5 7l8.5 6 8.5-6"],
  instagram: ["M7 3.5h10a3.5 3.5 0 0 1 3.5 3.5v10a3.5 3.5 0 0 1-3.5 3.5H7A3.5 3.5 0 0 1 3.5 17V7A3.5 3.5 0 0 1 7 3.5z", "M12 8.4a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2z", "M17.2 6.9h.01"],
  map: ["M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z", "M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"],
  nocross: ["M3 18c5-7 13-7 18 0", "M9 5l6 7", "M15 5l-6 7"],
  chat: ["M4 5.5h16v10H9l-4 3.5v-3.5H4z"],
  camera: ["M3.5 8h3.2l1.6-2.2h7.4L17.3 8h3.2v11h-17z", "M12 16.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"],
};

const d = paths[name] || [];
---
{d.length > 0 && (
  <svg
    class="btk-icon"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
  >
    {d.map((p) => <path d={p} />)}
  </svg>
)}
<style>
  .btk-icon {
    display: inline-block;
    vertical-align: -0.18em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
