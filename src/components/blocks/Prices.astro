---
const { block } = Astro.props;
---
<section class="section">
  <div class="container narrow">
    {block.heading && <h2 data-reveal="1">{block.heading}</h2>}
    <div class="list">
      {block.items.map((it, index) => (
        <div class="row" data-reveal="1" data-delay={(index % 4) * 100}>
          <div>
            <p class="name">{it.name}</p>
            {it.detail && <p class="detail faint">{it.detail}</p>}
          </div>
          <div class="lines">
            {it.lines.map((l) => <p class="line">{l}</p>)}
          </div>
        </div>
      ))}
    </div>
    {block.note && <p class="note faint">{block.note}</p>}
  </div>
</section>
<style>
  .list { display: grid; gap: var(--space-3); margin-top: var(--space-5); }
  .note { margin-top: var(--space-4); font-size: var(--size-small); }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: var(--space-5); padding: var(--space-5); border: 1px solid var(--line); border-radius: var(--radius); }
  .name { font-weight: var(--weight-medium); }
  .detail { font-size: var(--size-small); margin-top: var(--space-1); max-width: 42ch; }
  .lines { text-align: right; margin-left: auto; }
  .line { font-family: var(--font-display); font-size: var(--size-h3); line-height: 1.3; }
  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr; }
    .lines { margin-left: 0; text-align: left; }
  }
</style>
