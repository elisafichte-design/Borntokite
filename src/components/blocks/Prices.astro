---
const { block } = Astro.props;
---
<section class="section">
  <div class="container narrow">
    {block.heading && <h2>{block.heading}</h2>}
    <div class="list">
      {block.items.map((it) => (
        <div class="row">
          <div>
            <p class="name">{it.name}</p>
            {it.detail && <p class="detail faint">{it.detail}</p>}
          </div>
          <div class="lines">
            {it.lines.map((l) => <p class="line">{l}</p>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .list { margin-top: var(--space-5); }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-5); padding-block: var(--space-4); border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .row:last-child { border-bottom: 0; }
  .name { font-weight: var(--weight-medium); }
  .detail { font-size: var(--size-small); margin-top: var(--space-1); max-width: 42ch; }
  .lines { text-align: right; margin-left: auto; }
  .line { font-family: var(--font-display); font-size: var(--size-h3); line-height: 1.3; }
</style>
