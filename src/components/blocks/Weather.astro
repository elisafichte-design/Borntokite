---
// Windguru en chargement au clic. L'iframe n'est injectée qu'après action du
// visiteur : aucune requête vers un domaine tiers, donc aucun cookie tiers
// déposé sans son accord, donc pas de bandeau cookies à afficher.
const { block } = Astro.props;
const spot = block.spot || 118;
---
<section class="section">
  <div class="container narrow">
    {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
    {block.heading && <h2>{block.heading}</h2>}
    <div class="slot" data-spot={spot} data-label={block.loadLabel}>
      <button type="button" class="btn btn--ghost load">{block.loadLabel}</button>
      <p class="faint hint">{block.consent}</p>
    </div>
    {block.note && (
      <p class="faint note">
        {block.note} <a href={`https://www.windguru.cz/${spot}`} rel="noopener">windguru.cz</a>.
      </p>
    )}
    {block.liveHref && <a class="btn live" href={block.liveHref} target="_blank" rel="noopener">{block.liveLabel}</a>}
  </div>
</section>
<style>
  h2 { margin-top: var(--space-4); }
  .slot { margin-top: var(--space-6); border: 1px solid var(--line); padding: var(--space-7) var(--space-5); text-align: center; }
  .hint { margin-top: var(--space-3); font-size: var(--size-small); }
  .note { margin-top: var(--space-4); font-size: var(--size-small); }
  .live { margin-top: var(--space-5); }
  .slot :global(iframe) { display: block; width: 100%; height: 480px; border: 0; }
  .slot.on { padding: 0; border: 0; }
</style>
<script>
  document.querySelectorAll(".slot .load").forEach((btn) => {
    btn.addEventListener("click", () => {
      const slot = btn.closest(".slot");
      const f = document.createElement("iframe");
      f.src = `https://www.windguru.cz/int/iframe.php?id_spot=${slot.dataset.spot}`;
      f.title = slot.dataset.label;
      f.loading = "lazy";
      slot.textContent = "";
      slot.classList.add("on");
      slot.appendChild(f);
    });
  });
</script>
