---
// Le navigateur diffère le chargement du module Windguru jusqu'à ce que la
// section approche de la zone visible.
const { block } = Astro.props;
const spot = block.spot || 118;
const model = block.model || 92;
---
<section class="section">
  <div class="container narrow">
    {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
    {block.heading && <h2>{block.heading}</h2>}
    <div class="slot">
      <iframe
        src={`https://www.windguru.cz/widget-fcst-iframe.php?s=${spot}&m=${model}`}
        title={block.loadLabel}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    {block.note && (
      <p class="faint note">
        {block.note} <a href={`https://www.windguru.cz/${spot}`} rel="noopener">windguru.cz</a>.
      </p>
    )}
    {block.liveHref && <a class="btn live" href={block.liveHref} target="_blank" rel="noopener">{block.liveLabel}</a>}
  </div>
</section>
<style>
  h2 { margin-top: var(--space-4); }
  .slot { margin-top: var(--space-6); }
  .note { margin-top: var(--space-4); font-size: var(--size-small); }
  .live { margin-top: var(--space-5); }
  .slot :global(iframe) { display: block; width: 100%; height: 288px; border: 0; }
</style>
