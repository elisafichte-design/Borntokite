---
const { block } = Astro.props;

const levelClass = {
  beginner: "beginner",
  intermediate: "intermediate",
  advanced: "advanced",
};
---

<section class="spots section" aria-labelledby="spots-title">
  <div class="container">
    <header class="spots-intro narrow">
      <p class="eyebrow">{block.eyebrow}</p>
      <h2 id="spots-title">{block.title}</h2>
      <p class="lead">{block.intro}</p>
    </header>

    <div class="legend" aria-label={block.legendLabel}>
      <div class="legend-group activities">
        <span class="legend-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 19 12 12 21 5 12Z M12 3v18 M5 12h14 M12 21q2 3 5 2.5" /></svg>
          {block.kiteLabel}
        </span>
        <span class="legend-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 16q4-6 9-1t9-2 M3 16q4 4 9 0" /></svg>
          {block.surfLabel}
        </span>
      </div>
      <div class="legend-group levels">
        {block.levels.map((level) => (
          <span class="legend-item"><span class={`level-dot ${levelClass[level.key]}`}></span>{level.label}</span>
        ))}
      </div>
      <span class="legend-item school-mark"><span aria-hidden="true">★</span>{block.schoolLabel}</span>
    </div>

    <figure class="map">
      <figcaption>
        <span>{block.mapFromTo}</span>
        <span>{block.mapScale}</span>
      </figcaption>
      <svg viewBox="0 0 880 900" role="img" aria-labelledby="map-title map-desc">
        <title id="map-title">{block.mapTitle}</title>
        <desc id="map-desc">{block.mapDescription}</desc>
        <rect width="880" height="900" class="water" />

        <g class="water-lines" fill="none">
          <path d="M40 60q15-6 30 0t30 0 M60 140q15-6 30 0t30 0 M30 220q15-6 30 0t30 0 M90 300q15-6 30 0t30 0 M40 380q15-6 30 0t30 0 M60 620q15-6 30 0t30 0 M100 700q15-6 30 0t30 0 M180 760q15-6 30 0t30 0 M540 60q15-6 30 0t30 0 M420 120q15-6 30 0t30 0 M340 210q15-6 30 0t30 0 M600 500q15-6 30 0t30 0 M420 700q15-6 30 0t30 0 M300 830q15-6 30 0t30 0" />
        </g>

        <path class="lagoon" d="M60 470q35-55 105-65 50-5 75 25 22 35 22 105 0 55-62 70-90 15-135-45-25-60-5-90Z" />
        <path class="reef" d="M55 470q40-55 110-65 50-5 75 25 M65 560q45 40 110 20 50-14 80-45" />

        <path class="land" d="M660-20c-42 60-30 110-95 138-43 30-63 72-87 114-38 70-158 130-216 188-48 22-100 28-130 52-20 30 0 60 40 74 38 10 68-4 90-24 40 24 80 38 122 58 64 30 138 52 176 82 62 38 140 80 206 130 40 30 70 60 100 110h54V-20Z" />
        <path class="coast" d="M660-20c-42 60-30 110-95 138-43 30-63 72-87 114-38 70-158 130-216 188-48 22-100 28-130 52-20 30 0 60 40 74 38 10 68-4 90-24 40 24 80 38 122 58 64 30 138 52 176 82 62 38 140 80 206 130 40 30 70 60 100 110" />

        <g class="mountain" transform="translate(150 470)">
          <path d="m-46 34 28-64 16 22 16-32 32 74Z" />
          <path d="m-18-30 12 16 M14-40l8 20" />
        </g>

        <g class="crystal" transform="translate(232 530)">
          <path d="m-9 8 5-16 9-1 4 15-7 4Z" />
          <text x="18" y="5">Crystal Rock</text>
        </g>

        <g class="palm" transform="translate(600 600)">
          <path d="M0 40q-4-30 2-58 M2-18q-24-12-36 4 M2-18q-16-20-8-32 M2-18q8-22 2-36 M2-18q24-14 32 2 M2-18q20 12 30 24" />
        </g>

        <g class="compass" transform="translate(100 820)">
          <circle r="34" />
          <path class="north" d="M0-26 6 0 0 26-6 0Z" />
          <path d="M-26 0 0 6 26 0 0-6Z" />
          <text y="-40">N</text>
        </g>

        <g class="wind" transform="translate(340 760)">
          <path d="m40 30-70-60 M-30-30l14 2 M-30-30l4 14" />
          <text x="20" y="48">{block.windLabel}</text>
        </g>

        <path class="route" d="M555 660Q400 600 240 480" />

        {block.spots.map((spot) => (
          <g class={`pin pin-${levelClass[spot.levelKey]}`} transform={`translate(${spot.x} ${spot.y})`}>
            <circle r={spot.school ? 19 : 17} />
            <text class="pin-number" y="6">{spot.number}</text>
            {spot.school && <text class="pin-star" x="18" y="-17">★</text>}
            <g class="map-label" transform={`translate(${spot.labelX || 25} ${spot.labelY || 0})`}>
              <text y="4">{spot.mapName}</text>
            </g>
          </g>
        ))}
      </svg>
    </figure>

    <ol class="spot-list">
      {block.spots.map((spot) => (
        <li>
          <span class={`number ${levelClass[spot.levelKey]}`}>{spot.number}</span>
          <div class="spot-copy">
            <div class="spot-heading">
              <h3>{spot.name}</h3>
              <span class="activity">{spot.activity}</span>
              <span class={`level ${levelClass[spot.levelKey]}`}>{spot.level}</span>
              {spot.school && <span class="school-mark"><span aria-hidden="true">★</span>{block.schoolShortLabel}</span>}
            </div>
            <p>{spot.description}</p>
          </div>
        </li>
      ))}
    </ol>

    <footer class="note">
      <p>{block.disclaimer}</p>
      <p class="credit">Born To Kite · Le Morne<br /><span>borntokitemauritius.com</span></p>
    </footer>
  </div>
</section>

<style>
  .spots { border-block: 1px solid var(--line); }
  .spots-intro { display: grid; gap: var(--space-4); }
  .spots-intro h2 { max-width: 18ch; }
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-7);
    padding-block: var(--space-4);
    border-block: 1px solid var(--line);
  }
  .legend-group { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .legend-item, .activity, .level, .credit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .legend-item svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .level-dot { width: 12px; height: 12px; border: 1px solid var(--ink); border-radius: 50%; }
  .level-dot.beginner, .number.beginner { background: var(--surface); }
  .level-dot.intermediate, .number.intermediate { background: var(--ink-faint); color: var(--bg); }
  .level-dot.advanced, .number.advanced { background: var(--ink); color: var(--bg); }
  .school-mark { color: var(--accent); }

  .map { margin: var(--space-6) 0 0; border-bottom: 1px solid var(--line); }
  .map figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .map svg { width: min(100%, 880px); height: auto; display: block; margin-inline: auto; }
  .water { fill: var(--surface); }
  .water-lines { stroke: var(--ink-faint); stroke-width: 1.4; opacity: 0.28; stroke-linecap: round; }
  .lagoon { fill: var(--line); opacity: 0.65; }
  .reef { fill: none; stroke: var(--ink-muted); stroke-width: 2; stroke-dasharray: 2 8; stroke-linecap: round; }
  .land { fill: var(--bg); stroke: var(--ink); stroke-width: 4.5; stroke-linejoin: round; }
  .coast { fill: none; stroke: var(--line); stroke-width: 2; }
  .mountain path:first-child { fill: var(--ink); stroke: var(--ink); stroke-width: 3.5; }
  .mountain path:last-child { fill: none; stroke: var(--bg); stroke-width: 2; opacity: 0.55; }
  .crystal path { fill: var(--bg); stroke: var(--ink); stroke-width: 2; }
  .crystal text, .wind text { fill: var(--ink-muted); font-family: var(--font-mono); font-size: 11px; }
  .palm { fill: none; stroke: var(--ink); stroke-width: 2.6; stroke-linecap: round; }
  .compass circle { fill: var(--bg); stroke: var(--ink); stroke-width: 1.6; }
  .compass path { fill: var(--ink-faint); }
  .compass .north { fill: var(--accent); }
  .compass text { text-anchor: middle; fill: var(--ink); font-family: var(--font-mono); font-size: 11px; }
  .wind path, .route { fill: none; stroke: var(--ink-muted); stroke-width: 2; stroke-dasharray: 1 8; stroke-linecap: round; }
  .pin circle { stroke: var(--ink); stroke-width: 2.5; }
  .pin-beginner circle { fill: var(--surface); }
  .pin-intermediate circle { fill: var(--ink-faint); }
  .pin-advanced circle { fill: var(--ink); }
  .pin-number { text-anchor: middle; fill: var(--ink); font-family: var(--font-display); font-size: 17px; }
  .pin-intermediate .pin-number, .pin-advanced .pin-number { fill: var(--bg); }
  .pin-star { fill: var(--accent); font-size: 18px; stroke: var(--bg); stroke-width: 4; paint-order: stroke fill; }
  .map-label text {
    fill: var(--ink);
    stroke: var(--bg);
    stroke-width: 6;
    paint-order: stroke fill;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .spot-list { list-style: none; margin: var(--space-7) 0 0; padding: 0; }
  .spot-list li { display: grid; grid-template-columns: 44px 1fr; gap: var(--space-5); padding-block: var(--space-5); border-bottom: 1px solid var(--line); }
  .number { width: 40px; height: 40px; display: grid; place-items: center; border: 2px solid var(--ink); border-radius: 50%; font-family: var(--font-display); font-size: 1.05rem; }
  .spot-copy { display: grid; gap: var(--space-2); }
  .spot-heading { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  .spot-heading h3 { margin-right: var(--space-1); }
  .activity { color: var(--ink-muted); }
  .level { border: 1px solid var(--line); border-radius: var(--radius); padding: 3px var(--space-2); }
  .level.advanced { color: var(--ink); border-color: var(--ink); }
  .spot-copy p { max-width: 720px; color: var(--ink-muted); }
  .note { display: flex; justify-content: space-between; gap: var(--space-7); padding-top: var(--space-6); }
  .note > p:first-child { max-width: 720px; color: var(--ink-muted); font-size: var(--size-small); }
  .credit { display: block; text-align: right; color: var(--ink); white-space: nowrap; }
  .credit span { color: var(--ink-faint); font-size: var(--size-eyebrow); }

  @media (max-width: 680px) {
    .legend { align-items: flex-start; gap: var(--space-4); }
    .activities, .levels { width: 100%; }
    .map { margin-inline: calc(var(--gutter) * -1); }
    .map figcaption { padding-inline: var(--gutter); }
    .spot-list li { grid-template-columns: 36px 1fr; gap: var(--space-4); }
    .number { width: 34px; height: 34px; font-size: 0.95rem; }
    .note { flex-direction: column; gap: var(--space-4); }
    .credit { text-align: left; }
  }
</style>
