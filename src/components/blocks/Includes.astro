---
// Bloc "ce que vous obtenez" : une liste de réassurance (encadrement,
// matériel, sécurité...), affichée avant les tarifs pour donner du contexte
// au prix. Piste A : pas de carte, pas d'ombre — un simple filet à gauche de
// chaque ligne, dans l'esprit du reste du site (voir Reviews.astro, Faq.astro).
const { block, heading = 2 } = Astro.props;
const H = heading === 1 ? "h1" : "h2";
---
<section class="section includes">
  <div class="container">
    <div class="head narrow" data-reveal="1">
      {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
      <H>{block.title}</H>
    </div>
    <dl class="list">
      {block.items.map((it, index) => (
        <div class="item" data-reveal="1" data-delay={(index % 4) * 90}>
          <dt>{it.title}</dt>
          <dd>{it.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
<style>
  .includes { border-block: 1px solid var(--line); }
  .head h1, .head h2 { margin-top: var(--space-3); }
  .list { list-style: none; margin: var(--space-7) 0 0; padding: 0; display: grid; gap: var(--space-6); }
  .item { border-left: 2px solid var(--line); padding-left: var(--space-5); }
  dt { font-family: var(--font-display); font-size: 1.15rem; font-weight: 400; color: var(--ink); margin: 0; }
  dd { margin: var(--space-2) 0 0; color: var(--ink-muted); max-width: 62ch; }
  @media (min-width: 760px) {
    .list { grid-template-columns: repeat(2, 1fr); column-gap: var(--space-7); row-gap: var(--space-6); }
  }
</style>
