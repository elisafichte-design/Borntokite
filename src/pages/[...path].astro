---
import Base from "../layouts/Base.astro";
import Hero from "../components/blocks/Hero.astro";
import Prose from "../components/blocks/Prose.astro";
import Stats from "../components/blocks/Stats.astro";
import Prices from "../components/blocks/Prices.astro";
import Faq from "../components/blocks/Faq.astro";
import Cta from "../components/blocks/Cta.astro";
import ImageBlock from "../components/blocks/Image.astro";
import Reviews from "../components/blocks/Reviews.astro";
import WindMonths from "../components/blocks/WindMonths.astro";
import SectionNav from "../components/blocks/SectionNav.astro";
import Cards from "../components/blocks/Cards.astro";
import Gallery from "../components/blocks/Gallery.astro";
import Weather from "../components/blocks/Weather.astro";
import site from "../data/site.json";
import fr from "../data/pages.fr.json";
import en from "../data/pages.en.json";
import de from "../data/pages.de.json";

const dict = { fr, en, de };

export function getStaticPaths() {
  // `dict` est un const de frontmatter, invisible ici : getStaticPaths est hoisté
  // et ne voit que les imports. On reconstruit donc le dictionnaire localement.
  const pagesByLang = { fr, en, de };
  const out = [];
  for (const lang of site.locales) {
    for (const page of pagesByLang[lang].pages) {
      const prefix = lang === site.defaultLocale ? "" : `${lang}/`;
      out.push({
        params: { path: page.slug ? `${prefix}${page.slug}` : prefix.replace(/\/$/, "") || undefined },
        props: { lang, slug: page.slug },
      });
    }
  }
  return out;
}

const { lang, slug } = Astro.props;
const data = dict[lang];
const page = data.pages.find((p) => p.slug === slug);

const chemin = (l, sg) => (l === site.defaultLocale ? `/${sg}` : `/${l}/${sg}`).replace(/\/+/g, "/");
const canonicalUrl = new URL(chemin(lang, slug ? slug + "/" : ""), site.domain).href;

const components = { hero: Hero, prose: Prose, stats: Stats, prices: Prices, faq: Faq, cta: Cta, image: ImageBlock, cards: Cards, gallery: Gallery, weather: Weather, reviews: Reviews, windmonths: WindMonths, sectionnav: SectionNav };

// Un seul h1 par page : le hero le porte. Sans hero, c'est le premier prose titré.
const blocks = page.blocks || [];
const hasHero = blocks.some((b) => b.type === "hero");
const h1Index = hasHero ? -1 : blocks.findIndex((b) => b.type === "prose" && b.title);

// Données structurées : le socle sur toutes les pages, la FAQ quand il y en a une.
const graph = [
  {
    "@type": "SportsActivityLocation",
    "@id": `${site.domain}/#school`,
    name: site.name,
    description: page.description,
    url: site.domain,
    address: {
      "@type": "PostalAddress",
      streetAddress: site.street,
      addressLocality: site.locality,
      addressRegion: site.region,
      addressCountry: site.country,
    },
    geo: { "@type": "GeoCoordinates", latitude: site.latitude, longitude: site.longitude },
    sport: ["Kitesurfing", "Wingfoiling", "Surfing"],
    telephone: site.whatsapp,
    email: site.email,
    // sameAs : les profils officiels de l'école, vérifiés un par un.
    // C'est ce qui relie le site à l'entité que Google et les assistants IA
    // connaissent déjà. Ne jamais y mettre une URL non vérifiée.
    sameAs: site.sameAs,
  },
];

// Fil d'Ariane, sur toutes les pages sauf l'accueil.
if (slug) {
  const base = lang === site.defaultLocale ? "" : `/${lang}`;
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: site.name, item: new URL(`${base}/`, site.domain).href },
      { "@type": "ListItem", position: 2, name: page.title, item: canonicalUrl },
    ],
  });
}

// Course et Offer sur les pages qui portent des tarifs chiffrés.
// Les montants sont lus dans les blocs `prices`, jamais écrits en dur :
// changer un tarif dans le JSON met le balisage à jour tout seul.
if (page.course) {
  const offres = [];
  for (const b of blocks.filter((x) => x.type === "prices")) {
    for (const it of b.items || []) {
      for (const l of it.lines || []) {
        const prix = /(\d[\d\s]*)\s*€/.exec(l);
        if (!prix) continue; // « Sur demande » n'est pas une offre chiffrée
        const heures = /(\d+)\s*h(?:\s*(\d+))?/i.exec(l);
        offres.push({
          "@type": "Offer",
          name: heures ? `${it.name} — ${heures[0]}` : it.name,
          price: prix[1].replace(/\s/g, ""),
          priceCurrency: "EUR",
          availability: "https://schema.org/InStock",
          url: canonicalUrl,
        });
      }
    }
  }
  const duree = offres.length ? /(\d+)\s*h/i.exec(offres[0].name) : null;
  graph.push({
    "@type": "Course",
    name: page.title,
    description: page.description,
    url: canonicalUrl,
    provider: { "@id": `${site.domain}/#school` },
    inLanguage: lang,
    ...(offres.length ? { offers: offres } : {}),
    hasCourseInstance: {
      "@type": "CourseInstance",
      courseMode: "Onsite",
      location: { "@id": `${site.domain}/#school` },
      ...(duree ? { courseWorkload: `PT${duree[1]}H` } : {}),
    },
  });
}

const faqBlock = (page.blocks || []).find((b) => b.type === "faq");
if (faqBlock) {
  graph.push({
    "@type": "FAQPage",
    mainEntity: faqBlock.items.map((i) => ({
      "@type": "Question",
      name: i.q,
      acceptedAnswer: { "@type": "Answer", text: i.a },
    })),
  });
}

const jsonld = { "@context": "https://schema.org", "@graph": graph };
---

<Base
  title={page.title}
  description={page.description}
  lang={lang}
  slug={slug}
  nav={data.nav}
  ui={data.ui}
  jsonld={jsonld}
>
  {
    blocks.map((block, i) => {
      const C = components[block.type];
      if (!C) return null;
      const el = <C block={block} ui={data.ui} heading={i === h1Index ? 1 : 2} />;
      // Un bloc qui porte un `id` devient une cible d'ancre pour le menu de sections.
      return block.id ? <div id={block.id}>{el}</div> : el;
    })
  }
  {
    blocks.length === 0 && (
      <section class="section">
        <div class="container narrow">
          <p class="eyebrow">Page en préparation</p>
          <h1>{page.title}</h1>
          <p class="lead" style="margin-top:var(--space-5)">{page.description}</p>
        </div>
      </section>
    )
  }
</Base>
